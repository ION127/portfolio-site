---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MiniFlow from '../islands/MiniFlow.tsx';
import MetricStrip from './MetricStrip.astro';
import ProjectCard from './ProjectCard.astro';
import IncidentCard from './IncidentCard.astro';
import StackGrid from './StackGrid.astro';
import { localizePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const home = await getEntry('home', locale);
if (!home) throw new Error(`src/content/home/${locale}.yaml is missing`);
const h = home.data;
const inLocale = (id: string) => id.startsWith(`${locale}/`);
const projects = (await getCollection('projects', (e) => inLocale(e.id))).sort((a, b) => a.data.order - b.data.order);
// 'BARO — 자율주행 …' → 'BARO'
const projectTitle: Record<string, string> = Object.fromEntries(
  projects.map((p) => [p.id.split('/')[1], p.data.title.split(' — ')[0]]),
);
const projectOrder = (slug: string) => projects.findIndex((p) => p.id.split('/')[1] === slug);
const highlights = (await getCollection('incidents', (e) => inLocale(e.id) && e.data.highlight)).sort(
  (a, b) => projectOrder(a.data.project) - projectOrder(b.data.project) || a.data.order - b.data.order,
);
---
<BaseLayout title={t(locale, 'meta.siteTitle')} description={t(locale, 'meta.siteDescription')} locale={locale}>
  <main id="main" class="container home">
    <section class="hero">
      <div class="hero-text">
        <p class="kicker">{h.hero.kicker}</p>
        <h1>{h.hero.titleLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
        <p class="lead">{h.hero.lead}</p>
        <div class="cta">
          <a class="pri" href="#projects">{t(locale, 'hero.ctaProjects')} ↓</a>
          <a href={h.contacts.github} target="_blank" rel="noopener">{t(locale, 'hero.ctaGithub')}</a>
          {h.contacts.email && <a href={`mailto:${h.contacts.email}`}>{t(locale, 'hero.ctaEmail')}</a>}
        </div>
      </div>
      <div class="hero-flow">
        <MiniFlow
          client:visible
          scenes={['baro-telemetry', 'stockpulse-anomaly']}
          locale={locale}
          mode="auto"
          caption={h.hero.miniCaption}
        />
      </div>
    </section>

    <MetricStrip metrics={h.metrics} projectTitle={projectTitle} label={t(locale, 'home.metrics')} />

    <section id="projects" class="block">
      <h2>{t(locale, 'home.projects')}</h2>
      <div class="projects">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div>
    </section>

    <section id="ops" class="block">
      <div class="block-head">
        <h2>{t(locale, 'home.ops')}</h2>
        <a class="more" href="#projects">{t(locale, 'home.opsMore')} →</a>
      </div>
      <div class="ops">
        {highlights.map((entry) => (
          <IncidentCard
            entry={entry}
            locale={locale}
            variant="compact"
            projectLabel={projectTitle[entry.data.project]}
            href={localizePath(`/projects/${entry.data.project}/#incident-${entry.id.split('/')[1]}`, locale)}
          />
        ))}
      </div>
    </section>

    <section class="block">
      <h2>{t(locale, 'home.stack')}</h2>
      <StackGrid groups={h.stack} />
    </section>

    <section id="about" class="block">
      <h2>{t(locale, 'home.about')}</h2>
      <div class="about-grid">
        <div>
          {h.about.body
            ? h.about.body.split('\n\n').map((para) => <p>{para}</p>)
            : <p class="pending">{t(locale, 'home.aboutPending')}</p>}
        </div>
        <ul class="contacts">
          <li>
            <span>{t(locale, 'contact.github')}</span>
            <a href={h.contacts.github} target="_blank" rel="noopener">{h.contacts.github.replace('https://', '')}</a>
          </li>
          {h.contacts.email && (
            <li><span>{t(locale, 'contact.email')}</span><a href={`mailto:${h.contacts.email}`}>{h.contacts.email}</a></li>
          )}
          {h.contacts.resume && (
            <li><span>{t(locale, 'contact.resume')}</span><a href={h.contacts.resume} target="_blank" rel="noopener">PDF</a></li>
          )}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    padding-bottom: 40px;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding: 64px 0 54px;
    border-bottom: 1px solid var(--border);
  }
  .kicker {
    margin: 0;
    font-size: 12.5px;
    color: var(--accent-text);
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  h1 {
    font-size: 40px;
    line-height: 1.28;
    letter-spacing: -1.6px;
    margin: 10px 0 16px;
    font-weight: 800;
  }
  .lead {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--muted);
    margin: 0 0 22px;
    max-width: 520px;
  }
  .cta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cta a {
    font-size: 13.5px;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 9px;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--surface);
  }
  .cta a.pri {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    font-weight: 700;
  }
  .hero-flow {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow);
    padding: 14px 16px 10px;
  }
  .block {
    padding: 46px 0;
    border-bottom: 1px solid var(--border);
  }
  .block:last-child {
    border-bottom: 0;
  }
  .block h2 {
    margin: 0 0 18px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.4px;
  }
  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .more {
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
  }
  .more:hover {
    color: var(--accent-text);
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }
  .ops {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 40px;
  }
  .contacts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .contacts li {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .contacts span {
    color: var(--muted);
    font-size: 12.5px;
    width: 70px;
    flex: none;
  }
  .contacts a {
    text-decoration: none;
  }
  @media (max-width: 899px) {
    .hero,
    .projects,
    .ops,
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero {
      padding-top: 40px;
    }
    h1 {
      font-size: 30px;
      letter-spacing: -1px;
    }
  }
</style>
