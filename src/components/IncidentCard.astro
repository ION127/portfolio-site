---
import { render, type CollectionEntry } from 'astro:content';
import { t, type Locale } from '../i18n';

interface Props {
  entry: CollectionEntry<'incidents'>;
  locale: Locale;
  variant: 'compact' | 'full';
  projectLabel?: string;
  href?: string;
}
const { entry, locale, variant, projectLabel, href } = Astro.props;
const d = entry.data;
const anchor = `incident-${entry.id.split('/')[1]}`;
const Body = variant === 'full' ? (await render(entry)).Content : null;
---
<article class:list={['incident', variant]} id={variant === 'full' ? anchor : undefined}>
  {projectLabel && <p class="tag">{projectLabel}</p>}
  <h3>{href ? <a href={href}>{d.title}</a> : d.title}</h3>
  <dl>
    <dt>{t(locale, 'incident.symptom')}</dt>
    <dd>{d.symptom}</dd>
    <dt>{t(locale, 'incident.cause')}</dt>
    <dd>{d.cause}</dd>
    <dt>{t(locale, 'incident.fix')}</dt>
    <dd>{d.fix}</dd>
    {variant === 'full' && d.result && (
      <>
        <dt>{t(locale, 'incident.result')}</dt>
        <dd>{d.result}</dd>
      </>
    )}
  </dl>
  {Body && <div class="body"><Body /></div>}
  {variant === 'full' && d.lesson && (
    <p class="lesson"><strong>{t(locale, 'incident.lesson')}</strong> {d.lesson}</p>
  )}
</article>

<style>
  .incident {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-box);
    padding: 16px 18px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .tag {
    margin: 0;
    font-size: 11.5px;
    font-weight: 800;
    color: var(--accent-text);
  }
  h3 {
    margin: 4px 0 10px;
    font-size: 16px;
    letter-spacing: -0.3px;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent-text);
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 6px 10px;
    font-size: 13.5px;
    line-height: 1.65;
  }
  dt {
    color: var(--muted);
    font-weight: 700;
  }
  dd {
    margin: 0;
  }
  .compact dl {
    font-size: 12.5px;
  }
  .body {
    margin-top: 12px;
    font-size: 14.5px;
  }
  .body :global(p) {
    margin: 0 0 10px;
  }
  .body :global(code) {
    font-size: 0.88em;
  }
  .lesson {
    margin: 10px 0 0;
    font-size: 14px;
    padding: 10px 12px;
    background: var(--surface2);
    border-radius: 8px;
  }
  @media (max-width: 599px) {
    dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px 0;
    }
    dd {
      margin-bottom: 6px;
    }
  }
</style>
