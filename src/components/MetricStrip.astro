---
interface Metric {
  value: string;
  unit: string;
  lines: string[];
  project: 'baro' | 'stockpulse';
  factId: string;
}
interface Props {
  metrics: Metric[];
  projectTitle: Record<string, string>;
  label: string;
}
const { metrics, projectTitle, label } = Astro.props;
---
<section class="metrics" aria-label={label}>
  {metrics.map((m) => (
    <div class="metric" data-fact={m.factId}>
      <p class="v">{m.value}{m.unit && <small>{m.unit}</small>}</p>
      <p class="d">{m.lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
      <p class="p">{projectTitle[m.project]}</p>
    </div>
  ))}
</section>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--border);
  }
  .metric {
    padding: 26px 20px 24px 0;
  }
  .metric + .metric {
    padding-left: 22px;
    border-left: 1px solid var(--border);
  }
  .v {
    margin: 0;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.2;
  }
  .v small {
    font-size: 15px;
    font-weight: 700;
    margin-left: 2px;
  }
  .d {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }
  .p {
    margin: 6px 0 0;
    font-size: 11.5px;
    color: var(--accent-text);
    font-weight: 700;
  }
  @media (max-width: 899px) {
    .metrics {
      grid-template-columns: 1fr 1fr;
    }
    .metric {
      padding-right: 12px;
    }
    .metric:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
