---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { localizePath, t, type Locale } from '../i18n';
import { SITE } from '../lib/site';

interface Props {
  locale: Locale;
  wide?: boolean;
  showLangToggle?: boolean;
}
const { locale, wide = false, showLangToggle = true } = Astro.props;
---
<header class="site-header">
  <a class="skip" href="#main">{t(locale, 'a11y.skip')}</a>
  <div class:list={['container', 'bar', { wide }]}>
    <a class="brand" href={localizePath('/', locale)}>{SITE.author[locale]}</a>
    <nav class="links" aria-label={t(locale, 'nav.label')}>
      <a href={localizePath('/#projects', locale)}>{t(locale, 'nav.projects')}</a>
      <a href={localizePath('/#ops', locale)}>{t(locale, 'nav.ops')}</a>
      <a href={localizePath('/#about', locale)}>{t(locale, 'nav.about')}</a>
    </nav>
    <div class="tools">
      {showLangToggle && <LangToggle locale={locale} />}
      <ThemeToggle labelToDark={t(locale, 'theme.toDark')} labelToLight={t(locale, 'theme.toLight')} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 56px;
  }
  .brand {
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 20px;
    margin-left: auto;
  }
  .links a {
    font-size: 13.5px;
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--text);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
  }
  .skip:focus {
    left: 16px;
    background: var(--text);
    color: var(--bg);
    padding: 6px 10px;
    border-radius: 6px;
    z-index: 100;
  }
  @media (max-width: 599px) {
    .links {
      display: none;
    }
  }
</style>
