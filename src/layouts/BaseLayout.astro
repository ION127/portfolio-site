---
import '../styles/global.css';
// Pretendard는 서브셋 선언이 92개(약 30KB)라 첫 화면을 막지 않도록 비동기로 적용한다(head의 link 참고).
import pretendardHref from 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css?url';
import '@fontsource/jetbrains-mono/latin-400.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { switchLocalePath, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  wide?: boolean;
  showLangToggle?: boolean;
  /** 다른 언어판이 있는 페이지면 true */
  alternates?: boolean;
  noindex?: boolean;
}
const {
  title,
  description,
  locale,
  wide = false,
  showLangToggle = true,
  alternates = true,
  noindex = false,
} = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).href;
const koUrl = new URL(switchLocalePath(Astro.url.pathname, 'ko'), site).href;
const enUrl = new URL(switchLocalePath(Astro.url.pathname, 'en'), site).href;
const ogImage = new URL(`/og-${locale}.png`, site).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates && (
      <>
        <link rel="alternate" hreflang="ko" href={koUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={koUrl} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={pretendardHref} as="style" />
    <link rel="stylesheet" href={pretendardHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={pretendardHref} /></noscript>
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = window.localStorage.getItem('theme');
        } catch (e) {
          theme = null;
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <Nav locale={locale} wide={wide} showLangToggle={showLangToggle && alternates} />
    <slot />
    <Footer locale={locale} wide={wide} />
  </body>
</html>
